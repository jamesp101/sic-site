{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "astro",
    "buildCommand": "node scripts/prisma-schema.mjs && prisma generate && astro build",
    "regions": ["sin1"],
    "git": { "deploymentEnabled": false },
    "crons": [{ "path": "/api/cron/storage-cleanup", "schedule": "17 3 * * *" }],
    "headers": [
        {
            "source": "/sic-seal(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
        }
    ]
}
