---
/**
 * Document shell shared by every layout: <html lang>, SEO head, fonts, theme
 * bootstrap (no flash of wrong theme). Theme is applied client-side only so
 * publicly cached HTML is identical for every visitor.
 */
import Seo, { type SeoProps } from '@/components/seo/Seo.astro';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import playfairLatin from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import '@/styles/app.css';
// Same file astro.config.mjs hashes for the CSP `script-src`.
import themeInit from '@/scripts/theme-init.js?raw';

type Props = SeoProps & { bodyClass?: string };
const { bodyClass = '', ...seo } = Astro.props;
// `transition:animate="none"` on <html>: ClientRouter (admin) swaps without a crossfade, so the new
// view appears as soon as it is ready.
---

<!doctype html>
<html lang="en" transition:animate="none">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#0a2e6e" />
        <meta name="color-scheme" content="light dark" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="alternate" type="application/rss+xml" title="San Isidro College — Posts" href="/rss.xml" />
        <link rel="sitemap" href="/sitemap.xml" />
        <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={playfairLatin} as="font" type="font/woff2" crossorigin />
        <script is:inline set:html={themeInit} />
        <Seo {...seo} />
        <slot name="head" />
    </head>
    <body class={bodyClass}>
        <slot />
    </body>
</html>
