---
import { renderContent } from '@/lib/blocks/content';

interface Props {
    content: string | null | undefined;
    /** Optional visible section title (rendered as h2). */
    title?: string | null;
    class?: string;
}

const { content, title, class: className = '' } = Astro.props;

const html = renderContent(content);
---

{html && (
    <section class:list={['border-b border-border bg-surface py-16 md:py-24', className]}>
        <div class="mx-auto w-full max-w-4xl px-6">
            {title && <h2 class="mb-6 text-3xl font-bold text-brand-800 md:text-4xl dark:text-foreground">{title}</h2>}
            <div class="max-w-none text-base leading-relaxed text-foreground" set:html={html} />
        </div>
    </section>
)}
