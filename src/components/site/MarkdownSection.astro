---
import AlbumLightbox from '@/components/site/AlbumLightbox.astro';
import { hasAlbum, parseContent } from '@/lib/blocks/content';

interface Props {
    content: string | null | undefined;
    /** Optional visible section title (rendered as h2). */
    title?: string | null;
    class?: string;
}

const { content, title, class: className = '' } = Astro.props;

const rich = parseContent(content);
const html = rich.html();
// Same container as the header and banner, so the section's left edge lines up with them. Text gets its reading
// measure per element (`app.css`: `[data-sic-blocks]` for block documents, `[data-sic-markdown]` for Legacy
// Markdown; both markers come from the renderers); grids, cards and accordions use the full width.
---

{html && (
    <>
        <section data-content-section class:list={['border-b border-border bg-surface py-16 md:py-24', className]}>
            <div class="page-frame">
                {title && (
                    <h2 class="mb-6 text-3xl font-bold text-brand-800 md:text-4xl dark:text-foreground">{title}</h2>
                )}
                <div class="text-base leading-relaxed text-foreground" set:html={html} />
            </div>
        </section>
        {hasAlbum(html) && <AlbumLightbox />}
    </>
)}
