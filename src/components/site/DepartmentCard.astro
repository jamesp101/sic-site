---
import type { DepartmentSummary } from '@/lib/content-types';
import { getInitials } from '@/lib/initials';

interface Props {
    department: DepartmentSummary;
}

const { department } = Astro.props;
---

<article class="group relative flex flex-col rounded-2xl border border-border bg-surface p-8 shadow-brand-sm transition duration-200 hover:-translate-y-1 hover:shadow-brand-md">
    {department.logoUrl ? (
        <img
            src={department.logoUrl}
            alt=""
            width="56"
            height="56"
            loading="lazy"
            decoding="async"
            class="h-14 w-14 rounded-xl object-contain"
        />
    ) : (
        <span
            class="flex h-14 w-14 items-center justify-center rounded-xl bg-brand-100 text-lg font-bold text-brand-800 dark:bg-surface-alt dark:text-gold-400"
            aria-hidden="true"
        >
            {getInitials(department.name) || 'D'}
        </span>
    )}
    <h3 class="mt-5 font-sans text-xl font-semibold text-foreground">
        <a href={`/departments/${department.slug}`} class="rounded after:absolute after:inset-0 after:content-['']">
            {department.name}
        </a>
    </h3>
    {department.description && (
        <p class="mt-3 line-clamp-4 flex-1 text-sm leading-relaxed text-muted-foreground">{department.description}</p>
    )}
    <p class="mt-6 border-t border-border pt-4 text-sm font-semibold text-link" aria-hidden="true">
        View department &rarr;
    </p>
</article>
