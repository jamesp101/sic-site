---
interface Props {
    /** `onDark` for navy backgrounds. */
    tone?: 'default' | 'onDark';
    class?: string;
}

const { tone = 'default', class: className = '' } = Astro.props;
const color = tone === 'onDark' ? 'text-gold-300' : 'text-link';
---

<p
    class:list={[
        "inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] before:h-0.5 before:w-8 before:rounded-sm before:bg-gold-500 before:content-['']",
        color,
        className,
    ]}
>
    <slot />
</p>
