---
import TypePill from './TypePill.astro';
import type { PostSummary } from '@/lib/content-types';
import { formatDate, formatDateRange } from '@/lib/format';

interface Props {
    post: PostSummary;
    variant?: 'default' | 'compact';
    /** Heading level for the title; use h2 when the card sits directly under the page h1. */
    headingLevel?: 'h2' | 'h3';
    /** Mark the image as above-the-fold (eager + high priority). */
    priority?: boolean;
}

const { post, variant = 'default', headingLevel = 'h3', priority = false } = Astro.props;
const Heading = headingLevel;
const compact = variant === 'compact';
const href = `/posts/${post.slug}`;
const showRange = post.type === 'event' && post.startDate;
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-brand-sm transition duration-200 hover:-translate-y-1 hover:shadow-brand-md">
    {post.imageUrl ? (
        <img
            src={post.imageUrl}
            alt=""
            width="800"
            height="450"
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : undefined}
            decoding="async"
            class:list={['w-full object-cover', compact ? 'h-40' : 'h-48']}
        />
    ) : (
        <div
            class:list={[
                'flex w-full items-center justify-center bg-brand-100 dark:bg-surface-alt',
                compact ? 'h-40' : 'h-48',
            ]}
        >
            <img
                src="/sic-seal-96.webp"
                srcset="/sic-seal-96.webp 96w, /sic-seal.webp 224w"
                sizes="64px"
                alt=""
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
                class="h-16 w-16 opacity-60"
            />
        </div>
    )}
    <div class:list={['flex flex-1 flex-col', compact ? 'p-5' : 'p-6']}>
        <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
            <TypePill type={post.type} />
            {post.department && <span>{post.department.name}</span>}
        </div>
        <Heading
            class:list={[
                'font-sans font-semibold leading-snug text-foreground',
                compact ? 'mt-2 text-base' : 'mt-3 text-lg',
            ]}
        >
            <a href={href} class="rounded after:absolute after:inset-0 after:content-[''] group-hover:text-link">
                {post.title}
            </a>
        </Heading>
        <p
            class:list={[
                'flex-1 leading-relaxed text-muted-foreground',
                compact ? 'mt-2 line-clamp-2 text-sm' : 'mt-3 line-clamp-3 text-sm',
            ]}
        >
            {post.excerpt}
        </p>
        {showRange && (
            <p class="mt-4 text-xs font-semibold text-link">
                <time datetime={post.startDate!.toISOString()}>{formatDateRange(post.startDate, post.endDate)}</time>
            </p>
        )}
        <p class="mt-5 flex items-center justify-between border-t border-border pt-4 text-xs text-muted-foreground">
            <time datetime={post.createdAt.toISOString()}>{formatDate(post.createdAt)}</time>
            <span class="font-semibold text-link" aria-hidden="true">
                Read more
            </span>
        </p>
    </div>
</article>
