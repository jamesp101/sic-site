---
import TypePill from './TypePill.astro';
import { card } from './classes';
import type { PostSummary } from '@/lib/content-types';
import { formatDate, formatDateRange } from '@/lib/format';
import { postHref } from '@/lib/site-nav';

interface Props {
    post: PostSummary;
    variant?: 'default' | 'compact';
    /** Heading level for the title; use h2 when the card sits directly under the page h1. */
    headingLevel?: 'h2' | 'h3';
    /** Mark the image as above-the-fold (eager + high priority). */
    priority?: boolean;
}

const { post, variant = 'default', headingLevel = 'h3', priority = false } = Astro.props;
const Heading = headingLevel;
const compact = variant === 'compact';
const href = postHref(post.slug);
// Cards sit in a 1-, 2- or 3-column grid (see the pages that list them): about 400 px wide on desktop.
const CARD_IMAGE_SIZES = '(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw';
const showRange = post.type === 'event' && post.startDate;
---

<article
    class:list={[
        card,
        'group relative flex flex-col overflow-hidden has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-ring has-[a:focus-visible]:ring-offset-2 has-[a:focus-visible]:ring-offset-background',
    ]}
>
    {post.imageUrl ? (
        <img
            src={post.imageUrl}
            srcset={post.imageSmallUrl ? `${post.imageSmallUrl} 640w, ${post.imageUrl} 1600w` : undefined}
            sizes={post.imageSmallUrl ? CARD_IMAGE_SIZES : undefined}
            alt=""
            width="800"
            height="450"
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : undefined}
            decoding="async"
            class="aspect-video w-full object-cover"
        />
    ) : (
        <div class="flex aspect-video w-full items-center justify-center bg-brand-100 dark:bg-surface-alt">
            <img
                src="/sic-seal-96.webp"
                srcset="/sic-seal-96.webp 96w, /sic-seal.webp 224w"
                sizes="64px"
                alt=""
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
                class="h-16 w-16 opacity-60"
            />
        </div>
    )}
    <div class:list={['flex flex-1 flex-col', compact ? 'p-5' : 'p-6']}>
        <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
            <TypePill type={post.type} />
            {post.department && <span>{post.department.name}</span>}
        </div>
        <Heading
            class:list={[
                'line-clamp-3 font-sans font-semibold leading-snug text-foreground',
                compact ? 'mt-2 text-base' : 'mt-3 text-lg',
            ]}
        >
            <a
                href={href}
                class="rounded outline-none after:absolute after:inset-0 after:content-[''] focus-visible:ring-0 focus-visible:ring-offset-0 group-hover:text-link"
            >
                {post.title}
            </a>
        </Heading>
        <p
            class:list={[
                'text-sm leading-relaxed text-muted-foreground',
                compact ? 'mt-2 line-clamp-2' : 'mt-3 line-clamp-3',
            ]}
        >
            {post.excerpt}
        </p>
        {showRange && (
            <p class="mt-4 text-xs font-semibold text-link">
                <time datetime={post.startDate!.toISOString()}>{formatDateRange(post.startDate, post.endDate)}</time>
            </p>
        )}
        <div class="mt-auto pt-5">
            <p class="flex items-center justify-between border-t border-border pt-4 text-xs text-muted-foreground">
                <time datetime={post.createdAt.toISOString()}>{formatDate(post.createdAt)}</time>
                <span class="font-semibold text-link" aria-hidden="true">
                    Read more{' '}
                    <span class="inline-block transition-transform duration-200 ease-out motion-safe:group-hover:translate-x-0.5">
                        &rarr;
                    </span>
                </span>
            </p>
        </div>
    </div>
</article>
