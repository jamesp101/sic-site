---
import Eyebrow from './Eyebrow.astro';
import { btnGold, btnOutline } from './classes';

interface Props {
    code: string;
    title: string;
    message: string;
}

const { code, title, message } = Astro.props;
---

<section class="py-20 md:py-28">
    <div class="mx-auto flex w-full max-w-2xl flex-col items-center px-6 text-center">
        <Eyebrow>Error {code}</Eyebrow>
        <h1 class="mt-4 text-4xl font-bold text-brand-800 md:text-5xl dark:text-foreground">{title}</h1>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground">{message}</p>
        <ul class="mt-8 flex flex-wrap justify-center gap-4">
            <li>
                <a href="/" class={btnGold}>
                    Back to home
                </a>
            </li>
            <li>
                <a href="/posts" class={btnOutline}>
                    News &amp; events
                </a>
            </li>
            <li>
                <a href="/contact" class={btnOutline}>
                    Contact us
                </a>
            </li>
        </ul>
    </div>
</section>
