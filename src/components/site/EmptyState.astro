---
interface Props {
    title: string;
    description?: string;
    actionHref?: string;
    actionLabel?: string;
}

const { title, description, actionHref, actionLabel } = Astro.props;
---

<div class="rounded-2xl border border-dashed border-border-strong bg-surface p-12 text-center">
    <p class="text-base font-semibold text-foreground">{title}</p>
    {description && <p class="mx-auto mt-2 max-w-md text-sm text-muted-foreground">{description}</p>}
    {actionHref && actionLabel && (
        <a
            href={actionHref}
            class="mt-6 inline-flex rounded-xl border border-border-strong px-4 py-2 text-sm font-semibold text-link hover:bg-surface-alt"
        >
            {actionLabel}
        </a>
    )}
    <slot />
</div>
