---
import { pageWindow } from '@/lib/pagination';

interface Props {
    /** The list's `ListState` (`runList`). */
    list: { page: number; pageCount: number; perPage: number; total: number; pageHref: (page: number) => string };
}

const { list } = Astro.props;
const { page, pageCount, perPage, total, pageHref } = list;
const first = (page - 1) * perPage + 1;
const last = Math.min(page * perPage, total);

const item =
    'inline-flex min-w-9 items-center justify-center rounded-lg px-3 py-1.5 text-sm font-semibold transition-colors';
const link = `${item} text-muted-foreground hover:bg-surface-alt hover:text-foreground`;
---

{total > 0 && (
    <div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
        <p class="text-sm text-muted-foreground">
            Showing {first}–{last} of {total}
        </p>
        {pageCount > 1 && (
            <nav aria-label="Pages">
                <ul class="flex flex-wrap items-center gap-1">
                    {page > 1 && (
                        <li>
                            <a href={pageHref(page - 1)} rel="prev" class={link}>
                                <span aria-hidden="true">←</span>&nbsp;Previous
                            </a>
                        </li>
                    )}
                    {pageWindow(page, pageCount).map((entry) =>
                        entry === null ? (
                            <li aria-hidden="true" class={`${item} text-muted-foreground`}>
                                …
                            </li>
                        ) : (
                            <li>
                                <a
                                    href={pageHref(entry)}
                                    aria-current={entry === page ? 'page' : undefined}
                                    aria-label={`Page ${entry}`}
                                    class={entry === page ? `${item} bg-primary text-primary-foreground` : link}
                                >
                                    {entry}
                                </a>
                            </li>
                        ),
                    )}
                    {page < pageCount && (
                        <li>
                            <a href={pageHref(page + 1)} rel="next" class={link}>
                                Next&nbsp;<span aria-hidden="true">→</span>
                            </a>
                        </li>
                    )}
                </ul>
            </nav>
        )}
    </div>
)}
