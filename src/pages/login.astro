---
import LoginForm from '@/components/auth/LoginForm.svelte';
import AuthLayout from '@/layouts/AuthLayout.astro';
import { signIn } from '@/lib/server/auth-session';
import { safeRedirect } from '@/lib/safe-redirect';

const redirect = safeRedirect(Astro.url.searchParams.get('redirect'));
if (Astro.locals.user) return Astro.redirect(redirect);

let email = '';
let error = '';

// No-JS fallback (or an island that failed to hydrate): the form POSTs here, never GETs, so
// credentials stay out of the URL. Goes through Better Auth's router so the sign-in rate limit applies.
if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    email = String(form.get('email') ?? '').trim();
    const result = await signIn({
        request: Astro.request,
        url: Astro.url,
        clientAddress: Astro.clientAddress,
        email,
        password: String(form.get('password') ?? ''),
        remember: form.get('remember') === 'on',
    });
    if (result.ok) {
        const out = new Headers({ Location: redirect });
        for (const cookie of result.setCookies) out.append('Set-Cookie', cookie);
        return new Response(null, { status: 303, headers: out });
    }
    Astro.response.status = result.status;
    error = result.message;
}

const status =
    Astro.url.searchParams.get('status') === 'password-reset'
        ? 'Your password has been reset. You can now log in.'
        : '';
---

<AuthLayout title="Log in to your account" description="Enter your email and password below to log in">
    <LoginForm client:load {redirect} {status} initialEmail={email} initialError={error} />
</AuthLayout>
