---
import { ArrowRight, CirclePlus, Download, FileText, School, Upload, Users } from '@lucide/svelte';
import { cardClass, eyebrowClass } from '@/components/admin/ui';
import AppLayout from '@/layouts/AppLayout.astro';
import ScopeIndicator from '@/components/admin/shared/ScopeIndicator.astro';
import { departmentWhere, scopeLabel } from '@/lib/server/admin-scope';
import { isSuperAdmin } from '@/lib/server/authz';
import { adminPage } from '@/lib/server/admin-page';
import { db } from '@/lib/server/db';

const page = await adminPage(Astro.locals.user);
if (page instanceof Response) return page;
const { actor } = page;

const scope = Astro.locals.adminScope;
const where = departmentWhere(actor, scope);
const [postsCount, downloadsCount, departmentsCount, usersCount] = await Promise.all([
    db.post.count({ where }),
    db.download.count({ where }),
    db.department.count(),
    db.user.count(),
]);

const user = Astro.locals.user!;
const stats = [
    { label: 'Posts & news', value: postsCount, note: 'Total articles & announcements', icon: FileText },
    { label: 'Downloads', value: downloadsCount, note: 'Total uploaded public files', icon: Download },
    { label: 'Departments', value: departmentsCount, note: 'Colleges & academic divisions', icon: School },
    { label: 'Users', value: usersCount, note: 'People who sign in to the admin', icon: Users },
];
const tasks = [
    {
        href: '/admin/posts/create',
        title: 'New post',
        text: 'Publish an article, event or announcement.',
        cta: 'New post',
        icon: CirclePlus,
    },
    {
        href: '/admin/downloads',
        title: 'Upload file',
        text: 'Add forms, calendars or guides to the public downloads page.',
        cta: 'Upload file',
        icon: Upload,
    },
    {
        href: '/',
        title: 'Preview public site',
        text: 'Open the public site to review your changes.',
        cta: 'Open site',
        icon: School,
        external: true,
    },
];
---

<AppLayout title="Dashboard" breadcrumbs={[{ title: 'Dashboard', href: '/dashboard' }]}>
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-8 p-6">
        <header class="space-y-2">
            <p class={eyebrowClass}>Admin</p>
            <h1 class="text-3xl font-bold tracking-tight text-foreground">
                Welcome back, {user.name || 'Administrator'}
            </h1>
            <p class="text-sm text-muted-foreground">
                {isSuperAdmin(actor)
                    ? 'Superadmin • Full administrative controls active.'
                    : `Department user • Managing content for ${scopeLabel(scope)}.`}
            </p>
            <ScopeIndicator />
        </header>

        <section aria-labelledby="overview" class="space-y-4">
            <h2 id="overview" class="text-xl font-bold tracking-tight text-foreground" data-test="dashboard-scope">
                Overview · {scopeLabel(scope)}
            </h2>
            <div class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
                {stats.map(({ label, value, note, icon: Icon }) => (
                    <div class={`${cardClass} flex flex-col p-4 sm:p-6`}>
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="font-sans text-xs font-semibold tracking-wider text-muted-foreground uppercase">
                                {label}
                            </h3>
                            <div class="shrink-0 rounded-lg bg-gold-500/10 p-2 text-gold-600 dark:text-gold-400">
                                <Icon class="h-5 w-5" aria-hidden="true" />
                            </div>
                        </div>
                        <p class="mt-4 text-3xl font-extrabold tabular-nums text-foreground">{value}</p>
                        <p class="mt-1 text-xs text-muted-foreground">{note}</p>
                    </div>
                ))}
            </div>
        </section>

        <section aria-labelledby="quick-tasks" class="space-y-4">
            <h2 id="quick-tasks" class="text-xl font-bold tracking-tight text-foreground">
                Quick tasks
            </h2>
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 lg:gap-6">
                {tasks.map(({ href, title, text, cta, icon: Icon, external }) => (
                    <a
                        href={href}
                        target={external ? '_blank' : undefined}
                        rel={external ? 'noopener' : undefined}
                        class={`${cardClass} group flex flex-col justify-between p-4 transition-[border-color,box-shadow] duration-200 ease-out hover:border-gold-500 hover:shadow-brand-md sm:p-6`}
                    >
                        <div class="space-y-2">
                            <div class="w-fit rounded-lg bg-gold-500/10 p-2.5 text-gold-600 dark:text-gold-400">
                                <Icon class="h-6 w-6" aria-hidden="true" />
                            </div>
                            <h3 class="mt-3 font-bold text-foreground transition-colors group-hover:text-link">
                                {title}
                            </h3>
                            <p class="text-sm leading-relaxed text-muted-foreground">{text}</p>
                        </div>
                        <span class="mt-6 flex items-center gap-1.5 text-sm font-bold text-link transition-[gap] duration-200 ease-out group-hover:gap-2.5">
                            {cta} <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
                        </span>
                    </a>
                ))}
            </div>
        </section>
    </div>
</AppLayout>
