---
import AppLayout from '@/layouts/AppLayout.astro';
import CarouselDesigner from '@/components/admin/carousels/CarouselDesigner.svelte';
import { db } from '@/lib/server/db';
import { toDesignerSlide } from '@/lib/server/carousel-admin';
import { departmentWhere, scopeDefaultDepartment, scopeLabel } from '@/lib/server/admin-scope';
import { isSuperAdmin } from '@/lib/server/authz';
import { adminPage } from '@/lib/server/admin-page';
import { departmentOptions } from '@/lib/server/department-access';

const access = await adminPage(Astro.locals.user);
if (access instanceof Response) return access;
const { actor } = access;

const superadmin = isSuperAdmin(actor);
// Slides follow the admin scope: `main` = slides without a department, a department = that department's slides.
const scope = Astro.locals.adminScope;
const [rows, departments] = await Promise.all([
    db.carouselItem.findMany({
        where: departmentWhere(actor, scope),
        orderBy: [{ order: 'asc' }, { id: 'asc' }],
    }),
    departmentOptions(actor),
]);
const slides = rows.map(toDesignerSlide);
const requested = Number(Astro.url.searchParams.get('slide'));
const initialId = slides.some((slide) => slide.id === requested) ? requested : (slides[0]?.id ?? null);
---

<AppLayout title="Carousel Designer" breadcrumbs={[{ title: 'Dashboard', href: '/dashboard' }, { title: 'Carousels' }]}>
    <CarouselDesigner
        client:load
        {slides}
        {departments}
        {initialId}
        scopeName={superadmin ? scopeLabel(scope) : null}
        defaultDepartmentId={scopeDefaultDepartment(scope)}
        superadmin={superadmin}
        lockedDepartmentId={superadmin ? null : (actor.departmentId ?? null)}
    />
</AppLayout>
