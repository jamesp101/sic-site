---
import AppLayout from '@/layouts/AppLayout.astro';
import CarouselDesigner from '@/components/admin/carousels/CarouselDesigner.svelte';
import { db } from '@/lib/server/db';
import { toDesignerSlide } from '@/lib/server/carousel-admin';
import { departmentFilter, isSuperAdmin, requireUser } from '@/lib/server/authz';
import { authzResponse } from '@/lib/server/authz-response';

let actor;
try {
    actor = requireUser(Astro.locals.user);
} catch (error) {
    return authzResponse(error);
}

const superadmin = isSuperAdmin(actor);
const [rows, departments] = await Promise.all([
    db.carouselItem.findMany({ where: departmentFilter(actor), orderBy: [{ order: 'asc' }, { id: 'asc' }] }),
    db.department.findMany({
        where: superadmin ? {} : { id: actor.departmentId ?? -1 },
        select: { id: true, name: true },
        orderBy: { name: 'asc' },
    }),
]);
const slides = rows.map(toDesignerSlide);
const requested = Number(Astro.url.searchParams.get('slide'));
const initialId = slides.some((slide) => slide.id === requested) ? requested : (slides[0]?.id ?? null);
---

<AppLayout title="Carousel Designer" breadcrumbs={[{ title: 'Dashboard', href: '/dashboard' }, { title: 'Carousels' }]}>
    <CarouselDesigner
        client:load
        {slides}
        {departments}
        {initialId}
        superadmin={superadmin}
        lockedDepartmentId={superadmin ? null : (actor.departmentId ?? null)}
    />
</AppLayout>
