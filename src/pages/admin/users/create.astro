---
import AppLayout from '@/layouts/AppLayout.astro';
import { formPageClass } from '@/components/admin/ui';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import UserForm from '@/components/admin/users/UserForm.svelte';
import { departmentOptions } from '@/lib/server/department-access';
import { adminPage } from '@/lib/server/admin-page';

const page = await adminPage(Astro.locals.user, { superAdmin: true });
if (page instanceof Response) return page;

const departments = await departmentOptions(page.actor);
---

<AppLayout
    title="New user"
    breadcrumbs={[
        { title: 'Dashboard', href: '/dashboard' },
        { title: 'Users', href: '/admin/users' },
        { title: 'New user' },
    ]}
>
    <div class={formPageClass}>
        <PageHeader
            title="New user"
            description="Add a person who signs in to the admin and set their role."
            backHref="/admin/users"
        />
        <UserForm client:load {departments} />
    </div>
</AppLayout>
