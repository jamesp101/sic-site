---
import AppLayout from '@/layouts/AppLayout.astro';
import { formPageClass } from '@/components/admin/ui';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import UserForm from '@/components/admin/users/UserForm.svelte';
import { db } from '@/lib/server/db';
import { departmentOptions } from '@/lib/server/department-access';
import { RequestError } from '@/lib/server/request-error';
import { adminPage, parseId } from '@/lib/server/admin-page';

const page = await adminPage(Astro.locals.user, {
    superAdmin: true,
    load: async () => {
        const id = parseId(Astro.params.id);
        const found = id === null ? null : await db.user.findUnique({ where: { id } });
        if (!found) throw new RequestError('NOT_FOUND');
        return found;
    },
});
if (page instanceof Response) return page;
const { row } = page;
const user = {
    id: row.id,
    name: row.name,
    email: row.email,
    role: row.role === 'superadmin' ? ('superadmin' as const) : ('department_user' as const),
    departmentId: row.departmentId,
};

const departments = await departmentOptions(page.actor);
---

<AppLayout
    title={`Edit ${user.name}`}
    breadcrumbs={[
        { title: 'Dashboard', href: '/dashboard' },
        { title: 'Users', href: '/admin/users' },
        { title: 'Edit user' },
    ]}
>
    <div class={formPageClass}>
        <PageHeader title="Edit user" description={`Change the details of ${user.name}.`} backHref="/admin/users" />
        <UserForm client:load {user} {departments} />
    </div>
</AppLayout>
