---
import { Pencil, Search } from '@lucide/svelte';
import AppLayout from '@/layouts/AppLayout.astro';
import ListPagination from '@/components/admin/shared/ListPagination.astro';
import AddLink from '@/components/admin/shared/AddLink.astro';
import EmptyRow from '@/components/admin/shared/EmptyRow.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import DeleteRowButton from '@/components/admin/shared/DeleteRowButton.astro';
import RowDeleteDialog from '@/components/admin/shared/RowDeleteDialog.svelte';
import { primaryButtonClass, secondaryButtonClass } from '@/components/admin/shared/form-utils';
import { cardClass, iconLinkClass, widePageClass, searchInputClass, thClass } from '@/components/admin/ui';
import SortableTh from '@/components/admin/shared/SortableTh.astro';
import { adminPage } from '@/lib/server/admin-page';
import { runList, sortBy } from '@/lib/server/admin-list';
import { db } from '@/lib/server/db';
import type { Prisma } from '@/generated/prisma/client';

const access = await adminPage(Astro.locals.user, { superAdmin: true });
if (access instanceof Response) return access;
const { actor } = access;

const rowSelect = {
    id: true,
    name: true,
    email: true,
    role: true,
    department: { select: { name: true } },
} satisfies Prisma.UserSelect;

// Superadmin only: every user is listed, so the Admin scope does not apply (`restriction: {}`).
const list = await runList<
    Prisma.UserWhereInput,
    Prisma.UserOrderByWithRelationInput,
    Prisma.UserGetPayload<{ select: typeof rowSelect }>
>({
    url: Astro.url,
    actor,
    scope: Astro.locals.adminScope,
    restriction: {},
    spec: {
        fields: {
            name: sortBy((dir) => ({ name: dir })),
            email: sortBy((dir) => ({ email: dir })),
            role: sortBy((dir) => ({ role: dir })),
            department: sortBy((dir) => ({ department: { name: dir } })),
        },
        defaultSort: 'name',
        tiebreak: { id: 'asc' },
        search: ['name', 'email'],
    },
    count: (where) => db.user.count({ where }),
    fetch: (args) => db.user.findMany({ ...args, select: rowSelect }),
});
const { rows: users, q, sort, dir } = list;
---

<AppLayout title="Users" breadcrumbs={[{ title: 'Dashboard', href: '/dashboard' }, { title: 'Users' }]}>
    <div class={widePageClass}>
        <PageHeader title="Users" description="People who sign in to the admin, with their roles and departments.">
            <AddLink href="/admin/users/create">New user</AddLink>
        </PageHeader>

        <form
            method="get"
            action="/admin/users"
            class={`${cardClass} flex flex-col items-center justify-between gap-4 p-4 md:flex-row`}
        >
            <div class="relative w-full md:max-w-xs">
                <Search
                    class="absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-muted-foreground"
                    aria-hidden="true"
                />
                <input
                    type="search"
                    name="q"
                    value={q}
                    placeholder="Search name or email…"
                    aria-label="Search users"
                    class={searchInputClass}
                />
            </div>
            <div class="flex w-full flex-col items-stretch gap-3 sm:flex-row sm:items-center md:w-auto">
                <input type="hidden" name="sort" value={sort} />
                <input type="hidden" name="dir" value={dir} />
                <button type="submit" class={primaryButtonClass}>
                    Search
                </button>
                {q && (
                    <a href="/admin/users" class={secondaryButtonClass}>
                        Reset
                    </a>
                )}
            </div>
        </form>

        <div class={`${cardClass} overflow-hidden`}>
            <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Users table">
                <table class="w-full border-collapse text-left text-sm">
                    <thead>
                        <tr class="border-b border-border bg-surface-alt">
                            <SortableTh list={list} field="name">
                                Name
                            </SortableTh>
                            <SortableTh list={list} field="email">
                                Email
                            </SortableTh>
                            <SortableTh list={list} field="role">
                                Role
                            </SortableTh>
                            <SortableTh list={list} field="department">
                                Department
                            </SortableTh>
                            <th scope="col" class={`${thClass} w-28 text-right`}>
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        {users.map((user) => (
                            <tr class="hover:bg-surface-alt/60">
                                <td class="px-6 py-3 font-semibold text-foreground">
                                    {user.name}
                                    {user.id === actor.id && (
                                        <span class="ml-2 text-xs font-normal text-muted-foreground">(you)</span>
                                    )}
                                </td>
                                <td class="px-6 py-3 text-muted-foreground">{user.email}</td>
                                <td class="px-6 py-3">
                                    {user.role === 'superadmin' ? (
                                        <span class="rounded-full bg-status-announcement-bg px-2 py-0.5 text-xs font-semibold text-status-announcement-fg">
                                            Superadmin
                                        </span>
                                    ) : (
                                        <span class="rounded-full bg-status-article-bg px-2 py-0.5 text-xs font-semibold text-status-article-fg">
                                            Department user
                                        </span>
                                    )}
                                </td>
                                <td class="px-6 py-3 text-xs font-semibold text-link">
                                    {user.department?.name ?? '—'}
                                </td>
                                <td class="px-6 py-3">
                                    <div class="flex justify-end gap-1.5">
                                        <a
                                            href={`/admin/users/${user.id}/edit`}
                                            class={iconLinkClass}
                                            aria-label={`Edit ${user.name}`}
                                            title="Edit user"
                                        >
                                            <Pencil class="h-4 w-4" aria-hidden="true" />
                                        </a>
                                        {user.id !== actor.id && (
                                            <DeleteRowButton kind="user" id={user.id} name={user.name} />
                                        )}
                                    </div>
                                </td>
                            </tr>
                        ))}
                        {users.length === 0 && (
                            <EmptyRow
                                colspan={5}
                                noun="users"
                                filtered={Boolean(q)}
                                createHref="/admin/users/create"
                                createLabel="New user"
                            />
                        )}
                    </tbody>
                </table>
            </div>
        </div>
        <ListPagination list={list} />
    </div>
    <RowDeleteDialog client:load />
</AppLayout>
