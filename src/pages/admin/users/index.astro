---
import AppLayout from '@/layouts/AppLayout.astro';
import AddLink from '@/components/admin/shared/AddLink.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import DeleteUserButton from '@/components/admin/users/DeleteUserButton.svelte';
import { db } from '@/lib/server/db';
import { requireSuperAdmin } from '@/lib/server/authz';
import { authzResponse } from '@/lib/server/authz-response';

let actor;
try {
    actor = requireSuperAdmin(Astro.locals.user);
} catch (error) {
    return authzResponse(error);
}

const users = await db.user.findMany({
    select: { id: true, name: true, email: true, role: true, department: { select: { name: true } } },
    orderBy: [{ name: 'asc' }, { id: 'asc' }],
});
---

<AppLayout title="Manage Users" breadcrumbs={[{ title: 'Dashboard', href: '/dashboard' }, { title: 'Users' }]}>
    <div class="mx-auto w-full max-w-7xl space-y-6 p-6">
        <PageHeader title="Users" description="Register and manage admin accounts, roles and department assignments.">
            <AddLink href="/admin/users/create">Add user</AddLink>
        </PageHeader>

        <div class="overflow-hidden rounded-xl border border-border bg-card shadow-brand-sm">
            <div class="overflow-x-auto">
                <table class="w-full border-collapse text-left text-sm">
                    <thead>
                        <tr class="border-b border-border bg-surface-alt text-xs font-bold uppercase tracking-wider text-muted-foreground">
                            <th scope="col" class="px-6 py-4">
                                Name
                            </th>
                            <th scope="col" class="px-6 py-4">
                                Email
                            </th>
                            <th scope="col" class="px-6 py-4">
                                Role
                            </th>
                            <th scope="col" class="px-6 py-4">
                                Department
                            </th>
                            <th scope="col" class="w-28 px-6 py-4 text-right">
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        {users.map((user) => (
                            <tr class="hover:bg-surface-alt/60">
                                <td class="px-6 py-3 font-semibold text-foreground">
                                    {user.name}
                                    {user.id === actor.id && (
                                        <span class="ml-2 text-xs font-normal text-muted-foreground">(you)</span>
                                    )}
                                </td>
                                <td class="px-6 py-3 text-muted-foreground">{user.email}</td>
                                <td class="px-6 py-3">
                                    {user.role === 'superadmin' ? (
                                        <span class="rounded-full bg-status-announcement-bg px-2 py-0.5 text-xs font-semibold text-status-announcement-fg">
                                            Super admin
                                        </span>
                                    ) : (
                                        <span class="rounded-full bg-status-article-bg px-2 py-0.5 text-xs font-semibold text-status-article-fg">
                                            Department editor
                                        </span>
                                    )}
                                </td>
                                <td class="px-6 py-3 text-xs font-semibold text-link">
                                    {user.department?.name ?? '—'}
                                </td>
                                <td class="px-6 py-3">
                                    <div class="flex justify-end gap-1.5">
                                        <a
                                            href={`/admin/users/${user.id}/edit`}
                                            class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-surface-alt hover:text-foreground"
                                            aria-label={`Edit ${user.name}`}
                                            title="Edit user"
                                        >
                                            <svg
                                                class="h-4 w-4"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                aria-hidden="true"
                                            >
                                                <path d="M12 20h9" />
                                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                            </svg>
                                        </a>
                                        {user.id !== actor.id && (
                                            <DeleteUserButton client:visible id={user.id} name={user.name} />
                                        )}
                                    </div>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</AppLayout>
