---
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import HeroSectionForm from '@/components/admin/hero-sections/HeroSectionForm.svelte';
import AppLayout from '@/layouts/AppLayout.astro';
import { widePageClass } from '@/components/admin/ui';
import { scopeDefaultDepartment } from '@/lib/server/admin-scope';
import { isSuperAdmin } from '@/lib/server/authz';
import { adminPage } from '@/lib/server/admin-page';
import { departmentOptions } from '@/lib/server/department-access';

const page = await adminPage(Astro.locals.user);
if (page instanceof Response) return page;
const { actor } = page;

const departments = await departmentOptions(actor);
---

<AppLayout
    title="New hero section"
    breadcrumbs={[
        { title: 'Dashboard', href: '/dashboard' },
        { title: 'Hero Sections', href: '/admin/hero-sections' },
        { title: 'New' },
    ]}
>
    <div class={widePageClass}>
        <PageHeader
            title="New hero section"
            description="Design a new hero panel for the Main site or a department page with the visual editor."
            backHref="/admin/hero-sections"
        />
        <HeroSectionForm
            client:load
            {departments}
            isSuperAdmin={isSuperAdmin(actor)}
            defaultDepartmentId={scopeDefaultDepartment(Astro.locals.adminScope)}
        />
    </div>
</AppLayout>
