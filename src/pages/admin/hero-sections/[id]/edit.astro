---
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import HeroSectionForm from '@/components/admin/hero-sections/HeroSectionForm.svelte';
import AppLayout from '@/layouts/AppLayout.astro';
import { isSuperAdmin } from '@/lib/server/authz';
import { adminPage, parseId } from '@/lib/server/admin-page';
import { departmentOptions, loadScoped } from '@/lib/server/department-access';

const page = await adminPage(Astro.locals.user, {
    load: (actor) => loadScoped(actor, 'heroSection', parseId(Astro.params.id)),
});
if (page instanceof Response) return page;
const { actor, row: section } = page;

const departments = await departmentOptions(actor);
const values = {
    id: section.id,
    title: section.title,
    content: section.content,
    order: section.order,
    isActive: section.isActive,
    departmentId: section.departmentId,
};
---

<AppLayout
    title="Edit Hero Section"
    breadcrumbs={[
        { title: 'Dashboard', href: '/dashboard' },
        { title: 'Hero Sections', href: '/admin/hero-sections' },
        { title: 'Edit' },
    ]}
>
    <div class="mx-auto w-full max-w-7xl space-y-6 p-6">
        <PageHeader
            title="Edit hero section"
            description={`Make changes to “${section.title || 'Hero section'}”.`}
            backHref="/admin/hero-sections"
        />
        <HeroSectionForm client:load {departments} isSuperAdmin={isSuperAdmin(actor)} section={values} />
    </div>
</AppLayout>
