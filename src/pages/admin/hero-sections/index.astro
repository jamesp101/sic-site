---
import { Eye, EyeOff, Pencil, Search, Sparkles } from '@lucide/svelte';
import ListPagination from '@/components/admin/shared/ListPagination.astro';
import AddLink from '@/components/admin/shared/AddLink.astro';
import EmptyRow from '@/components/admin/shared/EmptyRow.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import DeleteRowButton from '@/components/admin/shared/DeleteRowButton.astro';
import RowDeleteDialog from '@/components/admin/shared/RowDeleteDialog.svelte';
import SortableTh from '@/components/admin/shared/SortableTh.astro';
import { cardClass, iconLinkClass, pillClass, widePageClass, searchInputClass, thClass } from '@/components/admin/ui';
import { primaryButtonClass, secondaryButtonClass } from '@/components/admin/shared/form-utils';
import AppLayout from '@/layouts/AppLayout.astro';
import { adminPage } from '@/lib/server/admin-page';
import { runList, sortBy } from '@/lib/server/admin-list';
import { db } from '@/lib/server/db';
import type { Prisma } from '@/generated/prisma/client';

const access = await adminPage(Astro.locals.user);
if (access instanceof Response) return access;
const { actor } = access;

const rowSelect = {
    id: true,
    title: true,
    searchText: true,
    order: true,
    isActive: true,
    department: { select: { name: true } },
} satisfies Prisma.HeroSectionSelect;
const scope = Astro.locals.adminScope;
const list = await runList<
    Prisma.HeroSectionWhereInput,
    Prisma.HeroSectionOrderByWithRelationInput,
    Prisma.HeroSectionGetPayload<{ select: typeof rowSelect }>
>({
    url: Astro.url,
    actor,
    scope,
    spec: {
        fields: {
            title: sortBy((dir) => ({ title: dir })),
            department: sortBy((dir) => ({ department: { name: dir } })),
            order: sortBy((dir) => ({ order: dir })),
            active: sortBy((dir) => ({ isActive: dir })),
        },
        defaultSort: 'order',
        tiebreak: { id: 'asc' },
        search: ['title', 'searchText'],
    },
    count: (where) => db.heroSection.count({ where }),
    fetch: (args) => db.heroSection.findMany({ ...args, select: rowSelect }),
});
const { rows: sections, q, sort, dir } = list;
const showLocation = scope.kind === 'all';
const columns = [
    ['title', 'Section'],
    ...(showLocation ? [['department', 'Page location']] : []),
    ['order', 'Order'],
    ['active', 'Status'],
];
---

<AppLayout title="Hero sections" breadcrumbs={[{ title: 'Dashboard', href: '/dashboard' }, { title: 'Hero sections' }]}>
    <div class={widePageClass}>
        <PageHeader
            scoped
            title="Hero sections"
            description="Rich content panels for the Main site and department pages."
        >
            <AddLink href="/admin/hero-sections/create">New hero section</AddLink>
        </PageHeader>

        <form
            method="get"
            action="/admin/hero-sections"
            class={`${cardClass} flex flex-col items-center justify-between gap-4 p-4 md:flex-row`}
        >
            <div class="relative w-full md:max-w-xs">
                <Search
                    class="absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-muted-foreground"
                    aria-hidden="true"
                />
                <input
                    type="search"
                    name="q"
                    value={q}
                    placeholder="Search content…"
                    aria-label="Search hero sections"
                    class={searchInputClass}
                />
            </div>
            <div class="flex w-full flex-col items-stretch gap-3 sm:flex-row sm:items-center md:w-auto">
                <input type="hidden" name="sort" value={sort} />
                <input type="hidden" name="dir" value={dir} />
                <button type="submit" class={primaryButtonClass}>
                    Filter
                </button>
                {q && (
                    <a href="/admin/hero-sections" class={secondaryButtonClass}>
                        Reset
                    </a>
                )}
            </div>
        </form>

        <div class={`${cardClass} overflow-hidden`}>
            <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Hero sections table">
                <table class="w-full min-w-3xl border-collapse text-left">
                    <thead>
                        <tr class="border-b border-border bg-surface-alt">
                            {columns.map(([field, label]) => (
                                <SortableTh list={list} field={field}>
                                    {label}
                                </SortableTh>
                            ))}
                            <th scope="col" class={`${thClass} text-right`}>
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border text-sm">
                        {sections.map((hs) => (
                            <tr class="hover:bg-surface-alt">
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gold-500/10 text-gold-600">
                                            <Sparkles class="h-4 w-4" aria-hidden="true" />
                                        </div>
                                        <div class="min-w-0">
                                            <span
                                                class="block max-w-xs truncate font-semibold text-foreground"
                                                title={hs.title || undefined}
                                            >
                                                {hs.title || 'Untitled section'}
                                            </span>
                                            <span
                                                class="mt-0.5 block max-w-xs truncate text-xs text-muted-foreground"
                                                title={hs.searchText || undefined}
                                            >
                                                {hs.searchText.slice(0, 75)}
                                                {hs.searchText.length > 75 ? '…' : ''}
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                {showLocation && (
                                    <td class="px-4 py-3">
                                        {hs.department ? (
                                            <span
                                                class={`${pillClass} max-w-48 truncate bg-secondary text-secondary-foreground`}
                                                title={hs.department.name}
                                            >
                                                {hs.department.name}
                                            </span>
                                        ) : (
                                            <span class={`${pillClass} bg-file-archive-bg text-file-archive-fg`}>
                                                Main site
                                            </span>
                                        )}
                                    </td>
                                )}
                                <td class="px-4 py-3 font-mono text-xs text-muted-foreground">#{hs.order}</td>
                                <td class="px-4 py-3">
                                    {hs.isActive ? (
                                        <span class={`${pillClass} bg-status-article-bg text-status-article-fg`}>
                                            <Eye class="h-3 w-3" aria-hidden="true" /> Active
                                        </span>
                                    ) : (
                                        <span class={`${pillClass} bg-secondary text-muted-foreground`}>
                                            <EyeOff class="h-3 w-3" aria-hidden="true" /> Inactive
                                        </span>
                                    )}
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex justify-end gap-2">
                                        <a
                                            href={`/admin/hero-sections/${hs.id}/edit`}
                                            class={iconLinkClass}
                                            aria-label={`Edit hero section ${hs.title ?? hs.id}`}
                                            title="Edit section"
                                        >
                                            <Pencil class="h-4 w-4" aria-hidden="true" />
                                        </a>
                                        <DeleteRowButton kind="heroSection" id={hs.id} name={hs.title ?? `#${hs.id}`} />
                                    </div>
                                </td>
                            </tr>
                        ))}
                        {sections.length === 0 && (
                            <EmptyRow
                                colspan={columns.length + 1}
                                noun="hero sections"
                                filtered={Boolean(q)}
                                createHref="/admin/hero-sections/create"
                                createLabel="New hero section"
                            />
                        )}
                    </tbody>
                </table>
            </div>
        </div>
        <ListPagination list={list} />
    </div>
    <RowDeleteDialog client:load />
</AppLayout>
