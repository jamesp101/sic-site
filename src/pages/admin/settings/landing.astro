---
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import LandingSettingsForm from '@/components/admin/settings/LandingSettingsForm.svelte';
import AppLayout from '@/layouts/AppLayout.astro';
import { widePageClass } from '@/components/admin/ui';
import { adminPage } from '@/lib/server/admin-page';
import { getWelcomeHero } from '@/lib/server/welcome-hero';

const page = await adminPage(Astro.locals.user, { superAdmin: true });
if (page instanceof Response) return page;

const welcomeHero = await getWelcomeHero();
---

<AppLayout
    title="Landing page settings"
    breadcrumbs={[{ title: 'Dashboard', href: '/dashboard' }, { title: 'Landing settings' }]}
>
    <div class={widePageClass}>
        <PageHeader
            title="Landing page settings"
            description="Design the main welcome page hero section with the visual editor."
        />
        <LandingSettingsForm client:load welcomeHeroContent={welcomeHero ?? ''} />
    </div>
</AppLayout>
