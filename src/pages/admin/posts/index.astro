---
import { Calendar, FileText, Megaphone, Pencil, Star } from '@lucide/svelte';
import ListPagination from '@/components/admin/shared/ListPagination.astro';
import AddLink from '@/components/admin/shared/AddLink.astro';
import EmptyRow from '@/components/admin/shared/EmptyRow.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import DeleteRowButton from '@/components/admin/shared/DeleteRowButton.astro';
import RowDeleteDialog from '@/components/admin/shared/RowDeleteDialog.svelte';
import SortableTh from '@/components/admin/shared/SortableTh.astro';
import {
    cardClass,
    formatDate,
    iconLinkClass,
    pillClass,
    widePageClass,
    selectClass,
    thClass,
} from '@/components/admin/ui';
import ListFilterBar from '@/components/admin/shared/ListFilterBar.astro';
import AppLayout from '@/layouts/AppLayout.astro';
import { POST_TYPES } from '@/lib/content-types';
import { adminPage } from '@/lib/server/admin-page';
import { listFilter, parseYesNo, runList, sortBy } from '@/lib/server/admin-list';
import { db } from '@/lib/server/db';
import { publicUrl } from '@/lib/server/storage';
import type { Prisma } from '@/generated/prisma/client';

const access = await adminPage(Astro.locals.user);
if (access instanceof Response) return access;
const { actor } = access;

// Each filter is declared once: its query parameter, how it parses, how a value narrows the `where`.
const filters = {
    type: listFilter<Prisma.PostWhereInput, (typeof POST_TYPES)[number]>(
        (raw) => POST_TYPES.find((t) => t === raw) ?? null,
        (type) => ({ type }),
    ),
    featured: listFilter<Prisma.PostWhereInput, boolean>(parseYesNo, (isFeatured) => ({ isFeatured })),
};
const rowSelect = {
    id: true,
    title: true,
    type: true,
    isFeatured: true,
    createdAt: true,
    highlightImagePath: true,
    department: { select: { name: true } },
    user: { select: { name: true } },
} satisfies Prisma.PostSelect;

const scope = Astro.locals.adminScope;
const list = await runList<
    Prisma.PostWhereInput,
    Prisma.PostOrderByWithRelationInput,
    Prisma.PostGetPayload<{ select: typeof rowSelect }>,
    typeof filters
>({
    url: Astro.url,
    actor,
    scope,
    spec: {
        fields: {
            title: sortBy((dir) => ({ title: dir })),
            type: sortBy((dir) => ({ type: dir })),
            department: sortBy((dir) => ({ department: { name: dir } })),
            featured: sortBy((dir) => ({ isFeatured: dir })),
            created: sortBy((dir) => ({ createdAt: dir }), 'desc'),
        },
        defaultSort: 'created',
        tiebreak: { id: 'desc' },
        search: ['title', 'searchText'],
    },
    filters,
    count: (where) => db.post.count({ where }),
    fetch: (args) => db.post.findMany({ ...args, select: rowSelect }),
});
const { rows: posts } = list;

const typeClass: Record<string, string> = {
    article: 'bg-status-article-bg text-status-article-fg',
    event: 'bg-status-event-bg text-status-event-fg',
    announcement: 'bg-status-announcement-bg text-status-announcement-fg',
};
const typeIcon = { article: FileText, event: Calendar, announcement: Megaphone } as const;
/** A single department or main page: the Department column adds nothing. */
const showDepartment = scope.kind === 'all';
const columns = [
    ['title', 'Post'],
    ['type', 'Type'],
    ...(showDepartment ? [['department', 'Department']] : []),
    ['featured', 'Featured'],
];
---

<AppLayout title="Posts" breadcrumbs={[{ title: 'Dashboard', href: '/dashboard' }, { title: 'Posts' }]}>
    <div class={widePageClass}>
        <PageHeader
            scoped
            title="Posts"
            description="Create, edit or delete articles, announcements and campus events."
        >
            <AddLink href="/admin/posts/create">New post</AddLink>
        </PageHeader>

        <ListFilterBar list={list} placeholder="Search posts…" label="Search posts">
            <select name="type" aria-label="Filter by type" class={selectClass}>
                <option value="">All types</option>
                {POST_TYPES.map((t) => (
                    <option value={t} selected={t === list.values.type}>
                        {t[0].toUpperCase() + t.slice(1)}
                    </option>
                ))}
            </select>
            <select name="featured" aria-label="Filter by featured" class={selectClass}>
                <option value="">All featured</option>
                <option value="yes" selected={list.values.featured === true}>
                    Featured only
                </option>
                <option value="no" selected={list.values.featured === false}>
                    Not featured
                </option>
            </select>
        </ListFilterBar>

        <div class={`${cardClass} overflow-hidden`}>
            <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Posts table">
                <table class="w-full min-w-3xl border-collapse text-left">
                    <thead>
                        <tr class="border-b border-border bg-surface-alt">
                            {columns.map(([field, label]) => (
                                <SortableTh list={list} field={field}>
                                    {label}
                                </SortableTh>
                            ))}
                            <th scope="col" class={`${thClass} text-right`}>
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border text-sm">
                        {posts.map((post) => {
                            const image = publicUrl(post.highlightImagePath);
                            const Icon = typeIcon[post.type as keyof typeof typeIcon] ?? FileText;
                            return (
                                <tr class="hover:bg-surface-alt">
                                    <td class="px-4 py-3">
                                        <div class="flex items-center gap-3">
                                            {image ? (
                                                <img
                                                    src={image}
                                                    alt=""
                                                    loading="lazy"
                                                    class="h-10 w-16 shrink-0 rounded-md border border-border object-cover"
                                                />
                                            ) : (
                                                <div
                                                    class={`flex h-10 w-16 shrink-0 items-center justify-center rounded-md ${typeClass[post.type] ?? 'bg-secondary text-secondary-foreground'}`}
                                                >
                                                    <Icon class="h-5 w-5" aria-hidden="true" />
                                                </div>
                                            )}
                                            <div class="min-w-0">
                                                <span
                                                    class="block max-w-60 truncate font-semibold text-foreground"
                                                    title={post.title}
                                                >
                                                    {post.title}
                                                </span>
                                                <span
                                                    class="mt-0.5 block max-w-60 truncate text-xs text-muted-foreground"
                                                    title={`Created ${formatDate(post.createdAt)} by ${post.user?.name ?? 'System'}`}
                                                >
                                                    {formatDate(post.createdAt)} · {post.user?.name ?? 'System'}
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class={`${pillClass} capitalize ${typeClass[post.type] ?? ''}`}>
                                            {post.type}
                                        </span>
                                    </td>
                                    {showDepartment && (
                                        <td class="px-4 py-3 text-muted-foreground">
                                            <span
                                                class="block max-w-40 truncate"
                                                title={post.department?.name ?? 'General (all departments)'}
                                            >
                                                {post.department?.name ?? 'General (all departments)'}
                                            </span>
                                        </td>
                                    )}
                                    <td class="px-4 py-3">
                                        {post.isFeatured ? (
                                            <span class={`${pillClass} bg-file-archive-bg text-file-archive-fg`}>
                                                <Star class="h-3 w-3 fill-current" aria-hidden="true" /> Featured
                                            </span>
                                        ) : (
                                            <span class="text-muted-foreground" aria-label="Not featured">
                                                –
                                            </span>
                                        )}
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="flex justify-end gap-2">
                                            <a
                                                href={`/admin/posts/${post.id}/edit`}
                                                class={iconLinkClass}
                                                aria-label={`Edit post ${post.title}`}
                                                title="Edit post"
                                            >
                                                <Pencil class="h-4 w-4" aria-hidden="true" />
                                            </a>
                                            <DeleteRowButton kind="post" id={post.id} name={post.title} />
                                        </div>
                                    </td>
                                </tr>
                            );
                        })}
                        {posts.length === 0 && (
                            <EmptyRow
                                colspan={columns.length + 1}
                                noun="posts"
                                filtered={list.filtered}
                                createHref="/admin/posts/create"
                                createLabel="New post"
                            />
                        )}
                    </tbody>
                </table>
            </div>
        </div>
        <ListPagination list={list} />
    </div>
    <RowDeleteDialog client:load />
</AppLayout>
