---
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import PostForm from '@/components/admin/posts/PostForm.svelte';
import AppLayout from '@/layouts/AppLayout.astro';
import { widePageClass } from '@/components/admin/ui';
import { isSuperAdmin } from '@/lib/server/authz';
import { adminPage, parseId } from '@/lib/server/admin-page';
import { departmentOptions, loadScoped } from '@/lib/server/department-access';
import { publicUrl } from '@/lib/server/storage';

const page = await adminPage(Astro.locals.user, {
    load: (actor) => loadScoped(actor, 'post', parseId(Astro.params.id)),
});
if (page instanceof Response) return page;
const { actor, row: post } = page;

const departments = await departmentOptions(actor);

const values = {
    id: post.id,
    title: post.title,
    slug: post.slug,
    content: post.content,
    type: post.type,
    startDate: post.startDate?.toISOString() ?? null,
    endDate: post.endDate?.toISOString() ?? null,
    departmentId: post.departmentId,
    isFeatured: post.isFeatured,
    highlightImageUrl: publicUrl(post.highlightImagePath),
};
---

<AppLayout
    title="Edit post"
    breadcrumbs={[
        { title: 'Dashboard', href: '/dashboard' },
        { title: 'Posts', href: '/admin/posts' },
        { title: 'Edit' },
    ]}
>
    <div class={widePageClass}>
        <PageHeader title="Edit post" description={`Make changes to “${post.title}”.`} backHref="/admin/posts" />
        <PostForm client:load {departments} isSuperAdmin={isSuperAdmin(actor)} post={values} />
    </div>
</AppLayout>
