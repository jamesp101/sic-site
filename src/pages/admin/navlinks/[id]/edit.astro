---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import NavLinkForm from '@/components/admin/navlinks/NavLinkForm.svelte';
import { db } from '@/lib/server/db';
import { AuthzError, requireSuperAdmin } from '@/lib/server/authz';
import { authzResponse, parseId } from '@/lib/server/authz-response';

let link;
let parentLinks;
try {
    requireSuperAdmin(Astro.locals.user);
    const id = parseId(Astro.params.id);
    link = id === null ? null : await db.navigationLink.findUnique({ where: { id } });
    if (!link) throw new AuthzError('NOT_FOUND');
    const hasChildren = (await db.navigationLink.count({ where: { parentId: link.id } })) > 0;
    parentLinks = hasChildren
        ? []
        : await db.navigationLink.findMany({
              where: { parentId: null, id: { not: link.id } },
              select: { id: true, label: true },
              orderBy: [{ order: 'asc' }, { id: 'asc' }],
          });
} catch (error) {
    return authzResponse(error);
}
---

<AppLayout
    title={`Edit ${link.label}`}
    breadcrumbs={[
        { title: 'Dashboard', href: '/dashboard' },
        { title: 'Navigation links', href: '/admin/navlinks' },
        { title: 'Edit link' },
    ]}
>
    <div class="mx-auto w-full max-w-3xl space-y-6 p-6">
        <PageHeader
            title="Edit navigation link"
            description={`Change the settings of "${link.label}".`}
            backHref="/admin/navlinks"
        />
        <NavLinkForm client:load {link} {parentLinks} />
    </div>
</AppLayout>
