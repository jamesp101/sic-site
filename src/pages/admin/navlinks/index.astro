---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import NavLinksEditor from '@/components/admin/navlinks/NavLinksEditor.svelte';
import { db } from '@/lib/server/db';
import { requireSuperAdmin } from '@/lib/server/authz';
import { authzResponse } from '@/lib/server/authz-response';
import type { NavNode } from '@/lib/nav-tree';

try {
    requireSuperAdmin(Astro.locals.user);
} catch (error) {
    return authzResponse(error);
}

const all = await db.navigationLink.findMany({ orderBy: [{ order: 'asc' }, { id: 'asc' }] });
const toNode = (link: (typeof all)[number]): NavNode => ({
    id: link.id,
    label: link.label,
    url: link.url,
    isActive: link.isActive,
    order: link.order,
    children: [],
});
const links: NavNode[] = all
    .filter((link) => link.parentId === null)
    .map((top) => ({
        ...toNode(top),
        children: all.filter((child) => child.parentId === top.id).map(toNode),
    }));
---

<AppLayout
    title="Navigation Links"
    breadcrumbs={[{ title: 'Dashboard', href: '/dashboard' }, { title: 'Navigation links' }]}
>
    <div class="mx-auto w-full max-w-7xl space-y-6 p-6">
        <PageHeader
            title="Navigation links"
            description="Arrange the links in the main website navigation bar. Drag to reorder or nest; changes go live as you drop."
        />
        <NavLinksEditor client:load {links} />
    </div>
</AppLayout>
