---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import NavLinksEditor from '@/components/admin/navlinks/NavLinksEditor.svelte';
import { db } from '@/lib/server/db';
import { requireSuperAdmin } from '@/lib/server/authz';
import { authzResponse } from '@/lib/server/authz-response';
import { PAGE_SUGGESTIONS, STATIC_PATHS, DEPARTMENTS_MENU_URL, type LinkSuggestion, type NavNode } from '@/lib/nav-tree';

try {
    requireSuperAdmin(Astro.locals.user);
} catch (error) {
    return authzResponse(error);
}

const all = await db.navigationLink.findMany({ orderBy: [{ order: 'asc' }, { id: 'asc' }] });
const toNode = (link: (typeof all)[number]): NavNode => ({
    id: link.id,
    label: link.label,
    url: link.url,
    isActive: link.isActive,
    order: link.order,
    children: [],
});
const links: NavNode[] = all
    .filter((link) => link.parentId === null)
    .map((top) => ({
        ...toNode(top),
        children: all.filter((child) => child.parentId === top.id).map(toNode),
    }));

const [departments, posts] = await Promise.all([
    db.department.findMany({ orderBy: { name: 'asc' }, select: { name: true, slug: true } }),
    db.post.findMany({ orderBy: [{ createdAt: 'desc' }, { id: 'desc' }], select: { title: true, slug: true } }),
]);

// Suggestions for the link picker: pages, the auto departments menu, every department, the 30 newest posts.
const suggestions: LinkSuggestion[] = [
    ...PAGE_SUGGESTIONS,
    { group: 'Pages', label: 'Departments menu (auto)', url: DEPARTMENTS_MENU_URL },
    ...departments.map((d): LinkSuggestion => ({ group: 'Departments', label: d.name, url: `/departments/${d.slug}` })),
    ...posts.slice(0, 30).map((p): LinkSuggestion => ({ group: 'Posts', label: p.title, url: `/posts/${p.slug}` })),
];
const knownPaths = [
    ...STATIC_PATHS,
    ...departments.map((d) => `/departments/${d.slug}`),
    ...posts.map((p) => `/posts/${p.slug}`),
];
---

<AppLayout
    title="Navigation Links"
    breadcrumbs={[{ title: 'Dashboard', href: '/dashboard' }, { title: 'Navigation links' }]}
>
    <div class="mx-auto w-full max-w-7xl space-y-6 p-6">
        <PageHeader
            title="Navigation links"
            description="Arrange the links in the main website navigation bar. Drag to reorder or nest; changes go live as you drop."
        />
        <NavLinksEditor client:load {links} {departments} {suggestions} {knownPaths} />
    </div>
</AppLayout>
