---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import NavLinksEditor from '@/components/admin/navlinks/NavLinksEditor.svelte';
import { db } from '@/lib/server/db';
import { getNavDepartments } from '@/lib/server/queries';
import { adminPage } from '@/lib/server/admin-page';
import { PAGE_SUGGESTIONS, postSlugsLinked, type LinkSuggestion, type NavNode } from '@/lib/nav-tree';
import { DEPARTMENTS_MENU_URL, STATIC_PATHS, departmentHref } from '@/lib/site-nav';

const page = await adminPage(Astro.locals.user, { superAdmin: true });
if (page instanceof Response) return page;

const all = await db.navigationLink.findMany({ orderBy: [{ order: 'asc' }, { id: 'asc' }] });
const toNode = (link: (typeof all)[number]): NavNode => ({
    id: link.id,
    label: link.label,
    url: link.url,
    isActive: link.isActive,
    order: link.order,
    children: [],
});
const links: NavNode[] = all
    .filter((link) => link.parentId === null)
    .map((top) => ({
        ...toNode(top),
        children: all.filter((child) => child.parentId === top.id).map(toNode),
    }));

const linkedSlugs = postSlugsLinked(all.map((link) => link.url));
const [departments, newestPosts, linkedPosts] = await Promise.all([
    getNavDepartments(),
    db.post.findMany({
        orderBy: [{ createdAt: 'desc' }, { id: 'desc' }],
        take: 30,
        select: { title: true, slug: true },
    }),
    linkedSlugs.length > 0
        ? db.post.findMany({ where: { slug: { in: linkedSlugs } }, select: { slug: true } })
        : Promise.resolve([]),
]);

// Suggestions for the link picker: pages, the auto departments menu, every department, the 30 newest posts.
const suggestions: LinkSuggestion[] = [
    ...PAGE_SUGGESTIONS,
    { group: 'Pages', label: 'Departments menu (auto)', url: DEPARTMENTS_MENU_URL },
    ...departments.map((d): LinkSuggestion => ({ group: 'Departments', label: d.name, url: departmentHref(d.slug) })),
    ...newestPosts.map((p): LinkSuggestion => ({ group: 'Posts', label: p.title, url: `/posts/${p.slug}` })),
];
// Paths the editor may treat as existing. Links only change through actions that reload this page, so the Posts
// to check are exactly those the stored links point at; no other slug is sent to the client.
const knownPaths = [
    ...STATIC_PATHS,
    ...departments.map((d) => departmentHref(d.slug)),
    ...linkedPosts.map((p) => `/posts/${p.slug}`),
];
---

<AppLayout
    title="Navigation Links"
    breadcrumbs={[{ title: 'Dashboard', href: '/dashboard' }, { title: 'Navigation links' }]}
>
    <div class="mx-auto w-full max-w-7xl space-y-6 p-6">
        <PageHeader
            title="Navigation links"
            description="Arrange the links in the main website navigation bar. Drag to reorder or nest; changes go live as you drop."
        />
        <NavLinksEditor client:load {links} {departments} {suggestions} {knownPaths} />
    </div>
</AppLayout>
