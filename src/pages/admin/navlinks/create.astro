---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import NavLinkForm from '@/components/admin/navlinks/NavLinkForm.svelte';
import { db } from '@/lib/server/db';
import { requireSuperAdmin } from '@/lib/server/authz';
import { authzResponse } from '@/lib/server/authz-response';

try {
    requireSuperAdmin(Astro.locals.user);
} catch (error) {
    return authzResponse(error);
}

const [parentLinks, last] = await Promise.all([
    db.navigationLink.findMany({
        where: { parentId: null },
        select: { id: true, label: true },
        orderBy: [{ order: 'asc' }, { id: 'asc' }],
    }),
    db.navigationLink.aggregate({ _max: { order: true } }),
]);
---

<AppLayout
    title="Add Navigation Link"
    breadcrumbs={[
        { title: 'Dashboard', href: '/dashboard' },
        { title: 'Navigation links', href: '/admin/navlinks' },
        { title: 'Add link' },
    ]}
>
    <div class="mx-auto w-full max-w-3xl space-y-6 p-6">
        <PageHeader
            title="Add navigation link"
            description="Configure a new link in the main website navigation bar."
            backHref="/admin/navlinks"
        />
        <NavLinkForm client:load {parentLinks} nextOrder={(last._max.order ?? -1) + 1} />
    </div>
</AppLayout>
