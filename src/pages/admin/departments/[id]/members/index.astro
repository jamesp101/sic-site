---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import OrgChartEditor from '@/components/admin/members/OrgChartEditor.svelte';
import { db } from '@/lib/server/db';
import { requireUser } from '@/lib/server/authz';
import { loadOwnDepartment } from '@/lib/server/department-access';
import { authzResponse, parseId } from '@/lib/server/authz-response';
import { publicUrl } from '@/lib/server/storage';

let department;
let members;
try {
    const actor = requireUser(Astro.locals.user);
    const id = parseId(Astro.params.id);
    department = await loadOwnDepartment(actor, id);
    members = (
        await db.member.findMany({ where: { departmentId: department.id }, orderBy: [{ order: 'asc' }, { id: 'asc' }] })
    ).map((m) => ({
        id: m.id,
        name: m.name,
        role: m.role,
        parentId: m.parentId,
        order: m.order,
        imageUrl: publicUrl(m.imagePath),
    }));
} catch (error) {
    return authzResponse(error);
}
---

<AppLayout
    title={`Org Chart - ${department.name}`}
    breadcrumbs={[
        { title: 'Dashboard', href: '/dashboard' },
        { title: 'Departments', href: '/admin/departments' },
        { title: department.name },
        { title: 'Members' },
    ]}
>
    <div class="mx-auto w-full max-w-7xl space-y-6 p-6">
        <PageHeader
            title="Faculty & org chart"
            description={`Edit the organizational structure of ${department.name} the way it appears on the public page.`}
            backHref="/admin/departments"
        />
        <OrgChartEditor
            client:load
            departmentId={department.id}
            departmentName={department.name}
            departmentSlug={department.slug}
            {members}
        />
    </div>
</AppLayout>
