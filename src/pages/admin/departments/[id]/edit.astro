---
import AppLayout from '@/layouts/AppLayout.astro';
import { formPageClass } from '@/components/admin/ui';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import DepartmentForm from '@/components/admin/departments/DepartmentForm.svelte';
import { loadOwnDepartment } from '@/lib/server/department-access';
import { adminPage, parseId } from '@/lib/server/admin-page';
import { publicUrl } from '@/lib/server/storage';

const page = await adminPage(Astro.locals.user, {
    load: (actor) => loadOwnDepartment(actor, parseId(Astro.params.id)),
});
if (page instanceof Response) return page;
const { row } = page;
const department = {
    id: row.id,
    name: row.name,
    description: row.description,
    heroContent: row.heroContent,
    logoUrl: publicUrl(row.logoPath),
};
---

<AppLayout
    title={`Edit ${department.name}`}
    breadcrumbs={[
        { title: 'Dashboard', href: '/dashboard' },
        { title: 'Departments', href: '/admin/departments' },
        { title: 'Edit' },
    ]}
>
    <div class={formPageClass}>
        <PageHeader
            title={`Edit ${department.name}`}
            description="Update the department description, logo and hero content."
            backHref="/admin/departments"
        />
        <DepartmentForm client:load {department} />
    </div>
</AppLayout>
