---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import DepartmentForm from '@/components/admin/departments/DepartmentForm.svelte';
import { db } from '@/lib/server/db';
import { AuthzError, requireUser, scopeDepartment } from '@/lib/server/authz';
import { authzResponse, parseId } from '@/lib/server/authz-response';
import { publicUrl } from '@/lib/server/storage';

let department;
try {
    const actor = requireUser(Astro.locals.user);
    const id = parseId(Astro.params.id);
    const row = id === null ? null : await db.department.findUnique({ where: { id } });
    if (!row) throw new AuthzError('NOT_FOUND');
    scopeDepartment(actor, { departmentId: row.id });
    department = {
        id: row.id,
        name: row.name,
        description: row.description,
        heroContent: row.heroContent,
        logoUrl: publicUrl(row.logoPath),
    };
} catch (error) {
    return authzResponse(error);
}
---

<AppLayout
    title={`Edit ${department.name}`}
    breadcrumbs={[
        { title: 'Dashboard', href: '/dashboard' },
        { title: 'Departments', href: '/admin/departments' },
        { title: 'Edit' },
    ]}
>
    <div class="mx-auto w-full max-w-4xl space-y-6 p-6">
        <PageHeader
            title={`Edit ${department.name}`}
            description="Update the department description, logo and hero content."
            backHref="/admin/departments"
        />
        <DepartmentForm client:load {department} />
    </div>
</AppLayout>
