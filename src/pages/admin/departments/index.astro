---
import { Network, Pencil, Search } from '@lucide/svelte';
import ListPagination from '@/components/admin/shared/ListPagination.astro';
import AddLink from '@/components/admin/shared/AddLink.astro';
import EmptyRow from '@/components/admin/shared/EmptyRow.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import DeleteRowButton from '@/components/admin/shared/DeleteRowButton.astro';
import RowDeleteDialog from '@/components/admin/shared/RowDeleteDialog.svelte';
import SortableTh from '@/components/admin/shared/SortableTh.astro';
import {
    cardClass,
    formatDate,
    iconLinkClass,
    widePageClass,
    searchInputClass,
    selectClass,
    thClass,
} from '@/components/admin/ui';
import { primaryButtonClass, secondaryButtonClass } from '@/components/admin/shared/form-utils';
import AppLayout from '@/layouts/AppLayout.astro';
import { getInitials } from '@/lib/initials';
import { adminPage } from '@/lib/server/admin-page';
import { runList, sortBy } from '@/lib/server/admin-list';
import { isSuperAdmin } from '@/lib/server/authz';
import { db } from '@/lib/server/db';
import { publicUrl } from '@/lib/server/storage';
import type { Prisma } from '@/generated/prisma/client';

const access = await adminPage(Astro.locals.user);
if (access instanceof Response) return access;
const { actor } = access;

const superadmin = isSuperAdmin(actor);
const params = Astro.url.searchParams;
const yesNo = (value: string | null) => (value === 'yes' ? true : value === 'no' ? false : null);
const hasLogo = yesNo(params.get('logo'));
const hasMembers = yesNo(params.get('members'));
const hasPosts = yesNo(params.get('posts'));

const rowSelect = {
    id: true,
    name: true,
    slug: true,
    description: true,
    logoPath: true,
    updatedAt: true,
    _count: { select: { members: true, posts: true, downloads: true } },
} satisfies Prisma.DepartmentSelect;

// Department rows are not owned by a department: a department user's restriction is their own row (`id`).
const list = await runList<
    Prisma.DepartmentWhereInput,
    Prisma.DepartmentOrderByWithRelationInput,
    Prisma.DepartmentGetPayload<{ select: typeof rowSelect }>
>({
    url: Astro.url,
    actor,
    scope: Astro.locals.adminScope,
    restriction: superadmin ? {} : { id: actor.departmentId ?? -1 },
    spec: {
        fields: {
            name: sortBy((dir) => ({ name: dir })),
            members: sortBy((dir) => ({ members: { _count: dir } }), 'desc'),
            posts: sortBy((dir) => ({ posts: { _count: dir } }), 'desc'),
            downloads: sortBy((dir) => ({ downloads: { _count: dir } }), 'desc'),
            updated: sortBy((dir) => ({ updatedAt: dir }), 'desc'),
        },
        defaultSort: 'name',
        tiebreak: { name: 'asc' },
        search: ['name', 'slug', 'description'],
    },
    filters: [
        hasLogo === true ? { logoPath: { not: null } } : hasLogo === false && { logoPath: null },
        hasMembers === true ? { members: { some: {} } } : hasMembers === false && { members: { none: {} } },
        hasPosts === true ? { posts: { some: {} } } : hasPosts === false && { posts: { none: {} } },
    ],
    count: (where) => db.department.count({ where }),
    fetch: (args) => db.department.findMany({ ...args, select: rowSelect }),
});
const { rows, q, sort, dir } = list;

const filtered = Boolean(q || hasLogo !== null || hasMembers !== null || hasPosts !== null);
const columns = [
    ['name', 'Department', ''],
    ['members', 'Members', 'text-right'],
    ['posts', 'Posts', 'text-right'],
    ['downloads', 'Downloads', 'text-right'],
    ['updated', 'Updated', ''],
];
const filters = [
    { name: 'logo', label: 'Logo', value: hasLogo, yes: 'With logo', no: 'Without logo' },
    { name: 'members', label: 'Org chart', value: hasMembers, yes: 'With members', no: 'No members' },
    { name: 'posts', label: 'Posts', value: hasPosts, yes: 'With posts', no: 'No posts' },
];
---

<AppLayout title="Departments" breadcrumbs={[{ title: 'Dashboard', href: '/dashboard' }, { title: 'Departments' }]}>
    <div class={widePageClass}>
        <PageHeader
            title="Departments"
            description="Edit department descriptions, hero sections and logos, and manage organizational charts."
        >
            {superadmin && <AddLink href="/admin/departments/create">New department</AddLink>}
        </PageHeader>

        <form
            method="get"
            action="/admin/departments"
            class={`${cardClass} flex flex-col items-center justify-between gap-4 p-4 md:flex-row`}
        >
            <div class="relative w-full md:max-w-xs">
                <Search
                    class="absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-muted-foreground"
                    aria-hidden="true"
                />
                <input
                    type="search"
                    name="q"
                    value={q}
                    placeholder="Search name, slug or description…"
                    aria-label="Search departments"
                    class={searchInputClass}
                />
            </div>
            <div class="flex w-full flex-col items-stretch gap-3 sm:flex-row sm:items-center md:w-auto">
                {filters.map((f) => (
                    <select name={f.name} aria-label={`Filter by ${f.label.toLowerCase()}`} class={selectClass}>
                        <option value="">{`Any ${f.label.toLowerCase()}`}</option>
                        <option value="yes" selected={f.value === true}>
                            {f.yes}
                        </option>
                        <option value="no" selected={f.value === false}>
                            {f.no}
                        </option>
                    </select>
                ))}
                <input type="hidden" name="sort" value={sort} />
                <input type="hidden" name="dir" value={dir} />
                <button type="submit" class={primaryButtonClass}>
                    Filter
                </button>
                {filtered && (
                    <a href="/admin/departments" class={secondaryButtonClass}>
                        Reset
                    </a>
                )}
            </div>
        </form>

        <div class={`${cardClass} overflow-hidden`}>
            <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Departments table">
                <table class="w-full border-collapse text-left">
                    <caption class="sr-only">
                        {`Departments, sorted by ${sort} ${dir === 'asc' ? 'ascending' : 'descending'}`}
                    </caption>
                    <thead>
                        <tr class="border-b border-border bg-surface-alt">
                            {columns.map(([field, label, align]) => (
                                <SortableTh
                                    list={list}
                                    field={field}
                                    class={`${align} ${field === 'name' ? '' : 'px-4! whitespace-nowrap'}`}
                                >
                                    {label}
                                </SortableTh>
                            ))}
                            <th scope="col" class={`${thClass} px-4! text-right`}>
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border text-sm">
                        {rows.map((dept) => {
                            const logo = publicUrl(dept.logoPath);
                            return (
                                <tr class="hover:bg-surface-alt">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-border bg-surface-alt">
                                                {logo ? (
                                                    <img
                                                        src={logo}
                                                        alt=""
                                                        loading="lazy"
                                                        class="h-full w-full object-contain p-0.5"
                                                    />
                                                ) : (
                                                    <span class="text-xs font-bold text-brand-800 dark:text-gold-400">
                                                        {getInitials(dept.name)}
                                                    </span>
                                                )}
                                            </div>
                                            <div class="min-w-0">
                                                <a
                                                    href={`/departments/${dept.slug}`}
                                                    class="block max-w-64 truncate font-semibold text-foreground hover:text-link"
                                                    title="View public page"
                                                >
                                                    {dept.name}
                                                </a>
                                                <span class="mt-0.5 block max-w-64 truncate text-xs text-muted-foreground">
                                                    /{dept.slug}
                                                    {dept.description && ` · ${dept.description}`}
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-4 text-right tabular-nums text-foreground">
                                        {dept._count.members}
                                    </td>
                                    <td class="px-4 py-4 text-right tabular-nums text-foreground">
                                        {dept._count.posts}
                                    </td>
                                    <td class="px-4 py-4 text-right tabular-nums text-foreground">
                                        {dept._count.downloads}
                                    </td>
                                    <td class="px-4 py-4 whitespace-nowrap text-muted-foreground">
                                        {formatDate(dept.updatedAt)}
                                    </td>
                                    <td class="px-4 py-4">
                                        <div class="flex justify-end gap-1.5">
                                            <a
                                                href={`/admin/departments/${dept.id}/edit`}
                                                class={iconLinkClass}
                                                aria-label={`Edit ${dept.name}`}
                                                title="Edit info"
                                            >
                                                <Pencil class="h-4 w-4" aria-hidden="true" />
                                            </a>
                                            <a
                                                href={`/admin/departments/${dept.id}/members`}
                                                class={iconLinkClass}
                                                aria-label={`Org chart of ${dept.name}`}
                                                title="Org chart"
                                            >
                                                <Network class="h-4 w-4" aria-hidden="true" />
                                            </a>
                                            {superadmin && (
                                                <DeleteRowButton kind="department" id={dept.id} name={dept.name} />
                                            )}
                                        </div>
                                    </td>
                                </tr>
                            );
                        })}
                        {rows.length === 0 && (
                            <EmptyRow
                                colspan={columns.length + 1}
                                noun="departments"
                                filtered={filtered}
                                createHref={superadmin ? '/admin/departments/create' : undefined}
                                createLabel="New department"
                            />
                        )}
                    </tbody>
                </table>
            </div>
        </div>
        <ListPagination list={list} />
    </div>
    {superadmin && <RowDeleteDialog client:load />}
</AppLayout>
