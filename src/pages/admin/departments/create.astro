---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/admin/shared/PageHeader.astro';
import DepartmentForm from '@/components/admin/departments/DepartmentForm.svelte';
import { requireSuperAdmin } from '@/lib/server/authz';
import { authzResponse } from '@/lib/server/authz-response';

try {
    requireSuperAdmin(Astro.locals.user);
} catch (error) {
    return authzResponse(error);
}
---

<AppLayout
    title="Create Department"
    breadcrumbs={[
        { title: 'Dashboard', href: '/dashboard' },
        { title: 'Departments', href: '/admin/departments' },
        { title: 'Create' },
    ]}
>
    <div class="mx-auto w-full max-w-4xl space-y-6 p-6">
        <PageHeader
            title="Create department"
            description="Add a new academic department or administrative unit."
            backHref="/admin/departments"
        />
        <DepartmentForm client:load />
    </div>
</AppLayout>
