---
import BrandHero from '@/components/site/BrandHero.astro';
import DepartmentCard from '@/components/site/DepartmentCard.astro';
import EmptyState from '@/components/site/EmptyState.astro';
import Eyebrow from '@/components/site/Eyebrow.astro';
import HeroCarousel from '@/components/site/HeroCarousel.svelte';
import MarkdownSection from '@/components/site/MarkdownSection.astro';
import PostCard from '@/components/site/PostCard.astro';
import PublicLayout from '@/layouts/PublicLayout.astro';
import { collegeOrganization } from '@/lib/seo';
import { getHomeData } from '@/lib/server/queries';
import { SITE } from '@/lib/site';

const { carousel, departments, latestPosts, welcomeHero, heroSections } = await getHomeData();
const site = Astro.site ?? new URL(Astro.url.origin);
---

<PublicLayout description={SITE.description} canonical="/" jsonLd={collegeOrganization(site)}>
    {carousel.length > 0 ? (
        <HeroCarousel client:visible slides={carousel} pageTitle={`${SITE.name} — ${SITE.motto}`} />
    ) : (
        <BrandHero />
    )}

    <MarkdownSection content={welcomeHero} />
    {heroSections.map((section) => (
        <MarkdownSection content={section.content} />
    ))}

    <section id="departments" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="programs-heading">
        <div class="mx-auto w-full max-w-7xl px-6">
            <div class="max-w-2xl">
                <Eyebrow>Academic programs</Eyebrow>
                <h2
                    id="programs-heading"
                    class="mt-3 text-3xl font-bold text-brand-800 md:text-4xl dark:text-foreground"
                >
                    Our departments
                </h2>
                <p class="mt-4 leading-relaxed text-muted-foreground">
                    Explore the academic departments of {SITE.name}, their programs, announcements and people.
                </p>
            </div>
            {departments.length > 0 ? (
                <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
                    {departments.map((department) => (
                        <DepartmentCard department={department} />
                    ))}
                </div>
            ) : (
                <div class="mt-12">
                    <EmptyState title="Departments will appear here soon." />
                </div>
            )}
        </div>
    </section>

    <section class="border-t border-border bg-surface py-16 md:py-24" aria-labelledby="latest-heading">
        <div class="mx-auto w-full max-w-7xl px-6">
            <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                <div>
                    <Eyebrow>News &amp; events</Eyebrow>
                    <h2
                        id="latest-heading"
                        class="mt-3 text-3xl font-bold text-brand-800 md:text-4xl dark:text-foreground"
                    >
                        Latest from San Isidro
                    </h2>
                    <p class="mt-3 text-muted-foreground">News, campus events and announcements.</p>
                </div>
                <a href="/posts" class="rounded text-sm font-semibold text-link underline-offset-4 hover:underline">
                    View all posts &rarr;
                </a>
            </div>
            {latestPosts.length > 0 ? (
                <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
                    {latestPosts.map((post) => (
                        <PostCard post={post} />
                    ))}
                </div>
            ) : (
                <div class="mt-12">
                    <EmptyState title="No posts yet." description="Check back soon for news and announcements." />
                </div>
            )}
        </div>
    </section>
</PublicLayout>
