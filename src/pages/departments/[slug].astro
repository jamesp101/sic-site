---
import Eyebrow from '@/components/site/Eyebrow.astro';
import HeroCarousel from '@/components/site/HeroCarousel.svelte';
import MarkdownSection from '@/components/site/MarkdownSection.astro';
import OrgChart from '@/components/site/OrgChart.astro';
import PageBanner from '@/components/site/PageBanner.astro';
import PostCard from '@/components/site/PostCard.astro';
import { textLink } from '@/components/site/classes';
import PublicLayout from '@/layouts/PublicLayout.astro';
import { postsHref } from '@/lib/post-filters';
import { siteUrl } from '@/lib/seo';
import { getDepartmentPage } from '@/lib/server/queries';

const { slug } = Astro.params;
const page = slug ? await getDepartmentPage(slug, siteUrl(Astro)) : null;
if (!page) return new Response(null, { status: 404, statusText: 'Not Found' });

// The layout's queries start once the Department exists (an unknown slug costs one query) and run beside the page's own.
const { department, carousel, posts, postCount, members, heroSections, seo, navLinks, departments } = page;
---

<PublicLayout {...seo} {navLinks} {departments}>
    {carousel.length > 0 && (
        <HeroCarousel client:visible slides={carousel} tall={false} label={`${department.name} highlights`} />
    )}

    <PageBanner eyebrow="Department" title={department.name} lead={department.description} />

    <MarkdownSection content={department.heroContent} />
    {heroSections.map((section) => (
        <MarkdownSection content={section.content} />
    ))}

    {members.length > 0 && (
        <section
            id="org-chart"
            class="scroll-mt-24 border-b border-border bg-surface-alt py-16 md:py-24"
            aria-labelledby="people-heading"
        >
            <div class="mx-auto w-full max-w-7xl px-6">
                <div class="text-center">
                    <Eyebrow>People</Eyebrow>
                    <h2
                        id="people-heading"
                        class="mt-3 text-3xl font-bold text-brand-800 md:text-4xl dark:text-foreground"
                    >
                        Leadership &amp; faculty
                    </h2>
                </div>
                <div class="mt-12 overflow-x-auto pb-4" role="region" aria-labelledby="people-heading" tabindex="0">
                    <div class="mx-auto w-max min-w-full">
                        <OrgChart nodes={members} />
                    </div>
                </div>
            </div>
        </section>
    )}

    {posts.length > 0 && (
        <section class="py-16 md:py-24" aria-labelledby="dept-posts-heading">
            <div class="mx-auto w-full max-w-7xl px-6">
                <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                    <h2
                        id="dept-posts-heading"
                        class="text-3xl font-bold text-brand-800 md:text-4xl dark:text-foreground"
                    >
                        Announcements &amp; events
                    </h2>
                    <a href={postsHref({ departmentId: department.id })} class={textLink}>
                        View all {postCount} from this department &rarr;
                    </a>
                </div>
                <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3">
                    {posts.map((post) => (
                        <PostCard post={post} variant="compact" />
                    ))}
                </div>
            </div>
        </section>
    )}
</PublicLayout>
