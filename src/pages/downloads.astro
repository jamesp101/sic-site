---
import DownloadBrowser from '@/components/site/DownloadBrowser.astro';
import FilterBar from '@/components/site/FilterBar.astro';
import PageBanner from '@/components/site/PageBanner.astro';
import PublicLayout from '@/layouts/PublicLayout.astro';
import { hasDownloadFilters, parseDownloadFilters } from '@/lib/post-filters';
import { getDownloadsPage } from '@/lib/server/downloads';
import { getNavLinks, startQuery } from '@/lib/server/queries';

// The layout's Navigation links run beside the page's queries, not after them.
const navLinks = startQuery(getNavLinks());
const filters = parseDownloadFilters(Astro.url.searchParams);
const { departments, seo, ...listing } = await getDownloadsPage(filters);
---

<PublicLayout {...seo} {navLinks} {departments}>
    <PageBanner
        eyebrow="Downloads"
        title="Documents & Files"
        lead="Browse official folders and download forms, academic guides, curriculum checklists and department schedules."
    />

    <section class="min-h-[50vh] py-12 md:py-16" aria-label="Files">
        <div class="page-frame space-y-10">
            <FilterBar
                action="/downloads"
                search={filters.search ?? ''}
                searchLabel="Search files"
                searchPlaceholder="Document name, tag or folder…"
                departmentId={filters.departmentId ?? null}
                departments={departments}
                hidden={filters.directory ? { directory: filters.directory } : {}}
                active={hasDownloadFilters(filters)}
                clearHref="/downloads"
            />
            <DownloadBrowser {...listing} />
        </div>
    </section>
</PublicLayout>
