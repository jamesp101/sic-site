---
import { renderContent } from '@/components/site/render-markdown';
import PostCard from '@/components/site/PostCard.astro';
import TypePill from '@/components/site/TypePill.astro';
import PublicLayout from '@/layouts/PublicLayout.astro';
import { formatDate, formatDateRange } from '@/lib/format';
import { oneLine, postJsonLd } from '@/lib/seo';
import { getPostBySlug, getRelatedPosts } from '@/lib/server/queries';

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;
if (!post) return new Response(null, { status: 404, statusText: 'Not Found' });

const related = await getRelatedPosts(post, 3);
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = `/posts/${post.slug}`;
const hasEventDates = post.type === 'event' && post.startDate;
---

<PublicLayout
    title={post.title}
    description={oneLine(post.excerpt) || post.title}
    {canonical}
    type="article"
    image={post.imageUrl}
    imageAlt={post.title}
    publishedTime={post.createdAt}
    modifiedTime={post.updatedAt}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'News & Events', href: '/posts' }, { label: post.title }]}
    jsonLd={postJsonLd(post, site, new URL(canonical, site).href)}
>
    <article class="py-12 md:py-20">
        <div class="mx-auto w-full max-w-3xl px-6">
            <header class="space-y-4">
                <div class="flex flex-wrap items-center gap-3 text-sm">
                    <TypePill type={post.type} />
                    {post.department && (
                        <a
                            href={`/departments/${post.department.slug}`}
                            class="rounded font-medium text-link underline-offset-4 hover:underline"
                        >
                            {post.department.name}
                        </a>
                    )}
                </div>
                <h1 class="text-3xl font-bold leading-tight text-brand-800 md:text-5xl dark:text-foreground">
                    {post.title}
                </h1>
                <p class="flex flex-wrap items-center gap-x-6 gap-y-1 border-y border-border py-4 text-sm text-muted-foreground">
                    <span>By {post.authorName}</span>
                    <span>
                        Published <time datetime={post.createdAt.toISOString()}>{formatDate(post.createdAt)}</time>
                    </span>
                    {post.updatedAt.getTime() - post.createdAt.getTime() > 86_400_000 && (
                        <span>
                            Updated <time datetime={post.updatedAt.toISOString()}>{formatDate(post.updatedAt)}</time>
                        </span>
                    )}
                </p>
            </header>

            {hasEventDates && (
                <section
                    aria-labelledby="event-details"
                    class="mt-8 rounded-2xl border border-border bg-status-event-bg p-6 text-status-event-fg"
                >
                    <h2 id="event-details" class="font-sans text-base font-semibold">
                        Event details
                    </h2>
                    <p class="mt-2 text-sm">
                        <span class="font-semibold">When:</span>{' '}
                        <time datetime={post.startDate!.toISOString()}>
                            {formatDateRange(post.startDate, post.endDate, { time: true })}
                        </time>
                    </p>
                </section>
            )}

            {post.imageUrl && (
                <img
                    src={post.imageUrl}
                    alt={post.title}
                    width="1600"
                    height="900"
                    fetchpriority="high"
                    decoding="async"
                    class="mt-8 max-h-[450px] w-full rounded-2xl object-cover"
                />
            )}

            <div class="mt-10 text-base leading-relaxed text-foreground" set:html={renderContent(post.content)} />

            <p class="mt-12 border-t border-border pt-6">
                <a href="/posts" class="rounded text-sm font-semibold text-link underline-offset-4 hover:underline">
                    &larr; Back to News &amp; Events
                </a>
            </p>
        </div>
    </article>

    {related.length > 0 && (
        <section class="border-t border-border bg-surface py-16" aria-labelledby="related-heading">
            <div class="mx-auto w-full max-w-7xl px-6">
                <h2 id="related-heading" class="text-3xl font-bold text-brand-800 dark:text-foreground">
                    Related posts
                </h2>
                <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-3">
                    {related.map((item) => (
                        <PostCard post={item} variant="compact" />
                    ))}
                </div>
            </div>
        </section>
    )}
</PublicLayout>
