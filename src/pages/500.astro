---
import ErrorPanel from '@/components/site/ErrorPanel.astro';
import PublicLayout from '@/layouts/PublicLayout.astro';

Astro.response.status = 500;
---

<PublicLayout title="Something went wrong" description="An unexpected error occurred on our side." noindex minimal>
    <ErrorPanel
        code="500"
        title="Something went wrong"
        message="An unexpected error occurred on our side. Please try again in a moment."
    />
</PublicLayout>
