# Site origin used for canonical URLs, sitemap and Open Graph.
SITE_URL=http://localhost:4321
PUBLIC_APP_NAME="San Isidro College"

# Database. Scheme picks the Prisma provider + driver adapter:
#   file:./storage/dev.db         -> sqlite (better-sqlite3)
#   mysql://user:pass@host:3306/db -> mysql / mariadb
#   postgresql://user:pass@host/db -> postgresql
DATABASE_URL="file:./storage/dev.db"

# Upload storage. STORAGE_DRIVER=local (default) or s3.
STORAGE_DRIVER=local
# local: files on disk under UPLOAD_DIR, served at /storage/*.
UPLOAD_DIR=./storage/uploads
# s3: any S3-compatible bucket (AWS S3, Cloudflare R2, Garage, SeaweedFS, DigitalOcean Spaces, ...).
# Credentials fall back to the AWS default chain (env, profile, instance role) when unset.
S3_BUCKET=
S3_REGION=us-east-1
# Custom endpoint for non-AWS services, e.g. http://127.0.0.1:8333 (SeaweedFS); empty for AWS.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for most self-hosted services (Garage, SeaweedFS).
S3_FORCE_PATH_STYLE=false
# Optional key prefix inside the bucket, e.g. sic
S3_PREFIX=
# Optional public base URL of the bucket/CDN. Set it to serve images directly from the bucket
# (bucket must be public-read); leave empty to stream every file through /storage/* (private bucket OK).
S3_PUBLIC_URL=

BETTER_AUTH_SECRET=change-me-to-a-32-char-random-string
BETTER_AUTH_URL=http://localhost:4321

# Mail. MAIL_MAILER=log prints mail to the console.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@sic.edu.ph
CONTACT_TO_ADDRESS=info@sic.edu.ph

# Seed passwords (never commit real ones).
SEED_SUPERADMIN_PASSWORD=password
SEED_DEPARTMENT_PASSWORD=password
